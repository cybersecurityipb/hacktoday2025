from Crypto.Util.number import *

R.<p,q,n,k,e,d,hint> = QQ[]
I = ideal([
    e*d-1-k*(p-1)*(q-1),
    n-p*q, 
    hint - (q*e**2 + p*d**2) 
    ])
# print(I.elimination_ideal([d, p]).gens())
f = q^4*e^4 + q^4*n*k^2 - 2*q^3*n^2*k^2 + q^2*n^3*k^2 - 2*q^3*n*k^2 + 4*q^2*n^2*k^2 - 2*q*n^3*k^2 - q^3*e^2*hint - 2*q^3*n*k + 2*q^2*n^2*k + q^2*n*k^2 - 2*q*n^2*k^2 + n^3*k^2 + 2*q^2*n*k - 2*q*n^2*k + q^2*n


n =  
hint =  
ct =  
e =  65537 

f = f(e=e, n=n, hint=hint)
for i in range(e):
    print(i)
    g = f(k = i)
    for q, _ in g.univariate_polynomial().change_ring(ZZ).roots():
        if int(q) != 0:
            print(int(q))
            print(int(n)%int(q))
            p = n//q
            d = pow(e,-1,(p-1)*(q-1))
            m = pow(ct, d, n)
            print(long_to_bytes(int(m)))
            exit()